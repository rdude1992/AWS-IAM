# Email Configuration for AWS Identity Center Review Reports (OPTIONAL)
# Copy this file to .env and fill in your values if you want email notifications
# Leave these commented out or empty if you don't want email functionality

# SMTP Server Configuration (REQUIRED for email)
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587

# Email Credentials (OPTIONAL - leave empty for relay hosts that don't require authentication)
# EMAIL_USERNAME=your-email@gmail.com
# EMAIL_PASSWORD=your-app-password

# Email Recipients (REQUIRED for email - comma-separated for multiple recipients)
# EMAIL_RECIPIENTS=admin@company.com,security@company.com

# Email Sender Name
# EMAIL_SENDER_NAME=AWS Identity Center Review System

# Email Subject
# EMAIL_SUBJECT=AWS Identity Center Access Review Report
