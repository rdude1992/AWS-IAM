# Email Configuration for AWS Identity Center Review Reports
# Copy this file to .env and fill in your values

# SMTP Server Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Email Credentials
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Email Recipients (comma-separated for multiple recipients)
EMAIL_RECIPIENTS=admin@company.com,security@company.com

# Email Sender Name
EMAIL_SENDER_NAME=AWS Identity Center Review System

# Email Subject
EMAIL_SUBJECT=AWS Identity Center Access Review Report