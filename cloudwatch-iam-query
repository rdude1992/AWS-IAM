fields @timestamp as eventTimeIST,
       userIdentity.principalId,
       eventName,
       responseElements.ConsoleLogin as loginStatus
| filter eventName = "ConsoleLogin"
| parse userIdentity.principalId "*:*" as discard, username
| stats
    max(eventTimeIST) as lastConsoleLoginIST,
    latest(loginStatus) as lastLoginStatus,
    sum(if(loginStatus = "Success", 1, 0)) as successfulAttempts,
    sum(if(loginStatus = "Failure", 1, 0)) as failedAttempts
  by username
| sort lastConsoleLoginIST desc
