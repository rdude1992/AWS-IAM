# Example .env configuration for email relay host (no authentication required)

# Required settings for email
SMTP_SERVER=relay.company.com
SMTP_PORT=25
EMAIL_RECIPIENTS=admin@company.com,security@company.com

# Optional settings (leave empty for relay hosts that don't require authentication)
EMAIL_USERNAME=
EMAIL_PASSWORD=

# Email customization
EMAIL_SENDER_NAME=AWS Identity Center Review System
EMAIL_SUBJECT=AWS Identity Center Access Review Report